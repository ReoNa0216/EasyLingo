{
  "name": "easylingo",
  "version": "2.0.1",
  "description": "A desktop language learning app powered by AI and SRS",
  "main": "src/index.html",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:win": "tauri build --bundles nsis",
    "assets": "node scripts/prepare-assets.js",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "playwright test",
    "check": "node --check src/app.js && node --check src/db-adapter.js"
  },
  "keywords": [
    "language-learning",
    "srs",
    "ai",
    "desktop-app"
  ],
  "author": "陈挚",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "2.12.4",
    "tailwindcss": "3.4.19"
  },
  "dependencies": {
    "chart.js": "4.6.1",
    "dompurify": "3.4.18",
    "flag-icons": "7.5.0",
    "fullcalendar": "6.1.20",
    "mammoth": "1.13.0",
    "marked": "18.2.0",
    "pdfjs-dist": "6.5.438"
  }
}
